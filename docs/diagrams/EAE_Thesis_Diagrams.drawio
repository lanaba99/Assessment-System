ntStyle=0;arcSize=8;spacing=6;whiteSpace=wrap;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1170" y="990" width="190" height="40" as="geometry"/></mxCell><mxCell id="c143" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#1E293B;fontSize=8.8;align=center;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;whiteSpace=wrap;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1360" y="990" width="190" height="40" as="geometry"/></mxCell><mxCell id="c144" value="Separation of Duties: workflow approval (workflows.approve) is deliberately gated by a DIFFERENT permission than initiation (workflows.manage) — the initiating role must not also approve its own request. As seeded, NO role holds workflows.approve; a custom role grant is required to use approve/reject in this environment." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;fontColor=#1E293B;fontSize=10;align=left;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;whiteSpace=wrap;spacingLeft=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="1045" width="1520" height="40" as="geometry"/></mxCell><mxCell id="c145" value="Central scope (Platform Super Admin) uses a structurally separate authorization model: a boolean is_super_admin flag or '*' wildcard in admin_permissions (JSON) on CentralAdminUser — there is no central_roles/central_permissions RBAC table." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E293B;fontSize=10;align=left;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;whiteSpace=wrap;spacingLeft=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="1095" width="1520" height="40" as="geometry"/></mxCell><mxCell id="c146" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#1E293B;fontSize=12;align=center;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="1150" widt