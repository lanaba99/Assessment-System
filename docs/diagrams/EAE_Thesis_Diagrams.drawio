><mxGeometry x="400" y="388" width="1200" height="40" as="geometry"/></mxCell><mxCell id="c34" value="EAE — Thesis Architecture Package — Source: verified repository" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#475569;fontSize=9;align=left;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="448" width="1150" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="21 ERD Shared (none)" id="21 ERD Shared (none)"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Figure 21. Module ERD — Shared" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#1E293B;fontSize=20;align=left;verticalAlign=middle;fontStyle=1;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1150" height="40" as="geometry"/></mxCell><mxCell id="c3" value="Shared owns no database tables — explanatory note in place of a fabricated ERD." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#475569;fontSize=12;align=left;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1150" height="26" as="geometry"/></mxCell><mxCell id="c4" value="Not Applicable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#64748B;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="1200" y="16" width="420" height="30" as="geometry"/></mxCell><mxCell id="c5" value="Detail — no independent schema" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#475569;fontSize=11;align=center;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="1200" y="50" width="420" height="22" as="geometry"/></mxCell><mxCell id="c6" value="Shared owns ZERO database tables.&#10;&#10;app/Domains/Shared/ contains only a Traits/ folder (3 files: BelongsToTenant.php, AutoFillsTenantId.php, UsesUuid.php) — no Models/, no Services/, no Controllers/, no migrations. It supplies cross-cutting Eloquent mixins consumed by nearly every other domain's models (tenant scoping, UUID primary keys), but it does not own or define any table of its own.&#10;&#10;Per instructions, no ERD is fabricated for this domain. It is also explicitly excluded from the DomainServiceProvider auto-discovery loop that wires up the other 13 domains' service providers (app/Providers/DomainServiceProvider.php:23-25 — &quot;if ($domainName === 'Shared') { continue; }&quot;)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#1E293B;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;size=14;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="1520" height="220" as="geometry"/></mxCell><mxCell id="c7" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#1E293B;fontSize=12;align=center;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="400" width="320" height="48" as="geometry"/></mxCell><mxCell id="c8" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#1E293B;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="400" width="320" height="22" as="geometry"/></mxCell><mxCell id="c9" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#64748B;strokeColor=#64748B;fontColor=#1E293B;fontSize=12;align=center;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="68" y="426" width="14" hei