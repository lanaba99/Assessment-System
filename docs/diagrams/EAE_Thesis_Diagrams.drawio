rrow=block;endFill=1;strokeColor=#94A3B8;strokeWidth=1;" edge="1" parent="1" source="c14" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c53" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#94A3B8;strokeWidth=1;" edge="1" parent="1" source="c14" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c54" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#DC2626;strokeWidth=1.6;" edge="1" parent="1" source="c9" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c55" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#94A3B8;strokeWidth=1;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c56" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#94A3B8;strokeWidth=1;" edge="1" parent="1" source="c9" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c57" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#DC2626;strokeWidth=1.6;" edge="1" parent="1" source="c9" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c58" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#94A3B8;strokeWidth=1;" edge="1" parent="1" source="c12" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c59" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#94A3B8;strokeWidth=1;" edge="1" parent="1" source="c12" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c60" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#DC2626;strokeWidth=1.6;" edge="1" parent="1" source="c12" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c61" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#94A3B8;strokeWidth=1;" edge="1" parent="1" source="c16" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c62" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#94A3B8;strokeWidth=1;" edge="1" parent="1" source="c16" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c63" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#94A3B8;strokeWidth=1;" edge="1" parent="1" source="c16" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c64" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#94A3B8;strokeWidth=1;" edge="1" parent="1" source="c16" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c65" value="Shared: cross-cutting&#10;Traits only (BelongsToTenant,&#10;AutoFillsTenantId, UsesUuid).&#10;No service dependencies." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#1E293B;fontSize=8.5;align=center;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="1400" y="260" width="200" height="60" as="geometry"/></mxCell><mxCell id="c66" value="Central: zero verified inbound&#10;or outbound edges among the&#10;14 domains — architecturally&#10;isolated (landlord scope)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#1E293B;fontSize=8.5;align=center;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="200" height="60" as="geometry"/></mxCell><mxCell id="c67" value="6 circular dependencies verified (red, bidirectional): ExamSession↔ExamEngine, ExamSession↔QuestionBank, ExamSession↔Grading, ExamSession↔Cohorts, QuestionBank↔Competency, ExamEngine↔Rules. Most cycle weight is Eloquent relationship typing (belongsTo/hasMany cross-referencing between two models in different domains), not recursive service calls. Identity has zero outbound edges — every other domain depends on it, never the reverse." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;fontColor=#1E293B;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;size=14;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="1560" height="70" as="geometry"/></mxCell><mxCell id="c68" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#1E293B;fontSize=12;align=center;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="960" width="340" height="114" as="geometry"/></mxCell><mxCell id="c69" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#1E293B;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="960" width="340" height="22" as="geometry"/></mxCell><mxCell id="c70" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2563EB;strokeColor=#2563EB;fontColor=#1E293B;fontSize=12;align=center;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="48" y="986" width="14" height="14" as="geometry"/></mxCell><mxCell id="c71" value="Domain (service-bearing)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#1E293B;fontSize=10.5;align=left;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="68" y="983" width="304" height="20" as="geometry"/></mxCell><mxCell id="c72" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#7C3AED;strokeColor=#7C3AED;fontColor=#1E293B;fontSize=12;align=center;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="48" y="1008" width="14" height="14" as="geometry"/></mxCell><mxCell id="c73" value="Identity (universal dependency sink)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#1E293B;fontSize=10.5;align=left;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="68" y="1005" width="304" height="20" as="geometry"/></mxCell><mxCell id="c74" value="" style="rounded=0;whiteSpace=wrap;htm