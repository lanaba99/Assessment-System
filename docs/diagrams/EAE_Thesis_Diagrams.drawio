lor=#1E293B;fontSize=12;align=center;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="48" y="690" width="14" height="14" as="geometry"/></mxCell><mxCell id="c47" value="Data store" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#1E293B;fontSize=10.5;align=left;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="68" y="687" width="304" height="20" as="geometry"/></mxCell><mxCell id="c48" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DC2626;strokeColor=#DC2626;fontColor=#1E293B;fontSize=12;align=center;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="48" y="712" width="14" height="14" as="geometry"/></mxCell><mxCell id="c49" value="Deferred (not implemented)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#1E293B;fontSize=10.5;align=left;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="68" y="709" width="304" height="20" as="geometry"/></mxCell><mxCell id="c50" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#94A3B8;strokeColor=#94A3B8;fontColor=#1E293B;fontSize=12;align=center;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="48" y="734" width="14" height="14" as="geometry"/></mxCell><mxCell id="c51" value="External client (out of repo scope)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#1E293B;fontSize=10.5;align=left;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="68" y="731" width="304" height="20" as="geometry"/></mxCell><mxCell id="c52" value="Local Sail dev adds meilisearch + mailpit (compose.yaml) not shown here (dev-only tooling). No scheduler container exists in local dev — only in compose.prod.yaml. Production compose stack has been validated only via `docker compose config` (static check) — never actually built or run (docs/PRODUCTION_OPERATIONS.md). This diagram does not imply production is currently deployed." style="shape=note;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#1E293B;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;size=14;" vertex="1" parent="1"><mxGeometry x="400" y="620" width="1220" height="90" as="geometry"/></mxCell><mxCell id="c53" value="Evidence: compose.yaml; compose.prod.yaml; docker/production/{Dockerfile,nginx.conf,php.ini}; config/queue.php; routes/console.php:26; config/mail.php; app/Http/Middleware/EnsureIdempotency.php; docs/PRODUCTION_OPERATIONS.md; docs/SECURITY_BASELINE.md; .github/workflows/tests.yml" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#1E293B;fontSize=9.5;align=left;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;fontStyle=2;spacingLeft=8;whiteSpace=wrap;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="730" width="1560" height="40" as="geometry"/></mxCell><mxCell id="c54" value="EAE — Thesis Architecture Package — Source: verified repository" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#475569;fontSize=9;align=left;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="1074" width="1150" height="18" as="geometry"/></mxCell><mxCell id="c55" value="03 High-Level Architecture" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#475569;fontSize=9;align=right;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="1200" y="1074" width="420" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="04 Multi-Tenancy Isolation" id="04 Multi-Tenancy Isolation"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Figure 4. Multi-Tenancy Data Isolation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#1E293B;fontSize=20;align=left;verticalAlign=middle;fontStyle=1;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1150" height="40" as="geometry"/></mxCell><mxCell id="c3" value="Central/landlord vs. tenant database boundaries and the tenant-resolution mechanism." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#475569;fontSize=12;align=left;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1150" height="26" as="geometry"/></mxCell><mxCell id="c4" value="Verified" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#2563EB;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="1200" y="16" width="420" height="30" as="geometry"/></mxCell><mxCell id="c5" value="Detail — database-level isolation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#475569;fontSize=11;align=center;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="1200" y="50" width="420" height="22" as="geometry"/></mxCell><mxCell id="c6" value="Isolation level: DATABASE-LEVEL — one physical MySQL database per tenant (stancl/tenancy DatabaseTenancyBootstrapper). NOT schema-level. NOT row-level." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1560" height="30" as="geometry"/></mxCell><mxCell id="c7" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E293B;fontSize=12;align=center;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="460" height="300" as="geometry"/></mxCell><mxCell id="c8" value="Central / Landlord Context (shared)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#2563EB;fontSize=11;align=left;verticalAlign=middle;fontStyle=1;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="48" y="154" width="300" height="20" as="geometry"/></mxCell><mxCell id="c9" value="tenants (organization records)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#1E293B;fontSize=10;align=left;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="56" y="182" width="428" height="26" as="geometry"/></mxCell><mxCell id="c10" value="domains (hostname ↔ tenant routing table)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#1E293B;fontSize=10;align=left;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="56" y="212" width="428" height="26" as="geometry"/></mxCell><mxCell id="c11" value="central_admin_users (super-admins)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#1E293B;fontSize=10;align=left;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="56" y="242" width="428" height="26" as="geometry"/></mxCell><mxCell id="c12" value="central_api_keys / central_audit_trails" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#1E293B;fontSize=10;align=left;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="56" y="272" width="428" height="26" as="geometry"/></mxCell><mxCell id="c13" value="central_global_settings" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#1E293B;fontSize=10;align=left;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="56" y="302" width="428" height="26" as="geometry"/></mxCell><mxCell id="c14" value="Tenant Resolution&#10;InitializeTenancyBySubdomain&#10;leftmost label of request host&#10;(e.g. acme.localhost → tenant &quot;acme&quot;)&#10;central_domains = [127.0.0.1, localhost]&#10;No header-based, no path-based resolution" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;fontColor=#1E293B;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="420" height="130" as="geometry"/></mxCell><mxCell id="c15" value="EnsureCentralDomain (central routes)&#10;PreventAccessFromCentralDomains (tenant routes)&#10;— mutually exclusive by construction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;fontColor=#1E293B;fontSize=9.5;align=center;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="560" y="300" width="420" height="60" as="geometry"/></mxCell><mxCell id="c16" value="Tenancy Bootstrappers&#10;(config/tenancy.php)&#10;&#10;DatabaseTenancyBootstrapper — DB connection&#10;CacheTenancyBootstrapper — cache keys&#10;FilesystemTenancyBootstrapper — storage&#10;QueueTenancyBootstrapper — queue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E293B;fontSize=10;align=center;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="1040" y="150" width="300" height="200" as="geometry"/></mxCell><mxCell id="c17" value="Tenant A Database&#10;tenant_&lt;uuid-a&gt;&#10;&#10;~89 tables per domain&#10;(Identity, ExamEngine, ExamSession,&#10;Grading, QuestionBank, ...)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#1E293B;fontSize=10.5;align=center;verticalAlign=middle;fontStyle=1;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="560" y="400" width="420" height="220" as="geometry"/></mxCell><mxCell id="c18" value="Tenant B Database&#10;tenant_&lt;uuid-b&gt;&#10;&#10;Same schema, fully&#10;separate physical database" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#1E293B;fontSize=10.5;align=center;verticalAlign=middle;fontStyle=1;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="1040" y="400" width="300" height="220" as="geometry"/></mxCell><mxCell id="c19" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#334155;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="tenancy initialized" style="html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=9;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="connection swapped&#10;for this request" style="html=1;endArrow=block;endFill=1;strokeColor=#059669;fontSize=9;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="different request,&#10;different tenant" style="html=1;endArrow=block;endFill=1;strokeColor=#059669;fontSize=9;dashed=1;" edge="1" parent="1" source="c16" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="host lookup" style="html=1;endArrow=block;endFill=1;strokeColor=#334155;fontSize=9;dashed=1;" edge="1" parent="1" source="c7" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="Defense-in-depth: tenant tables still carry a tenant_id column, but this is NOT the isolation boundary — a verified migration comment states 'under per-database tenancy every row in a tenant DB shares the same tenant_id' (2026_06_05_000040_optimize_question_bank_indexes.php), and redundant tenant_id indexes were later dropped for this reason." style="shape=note;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#1E293B;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;size=14;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="940" height="90" as="geometry"/></mxCell><mxCell id="c25" value="SECURITY NOTE: Tenant A must never read Tenant B data. This is enforced structurally, not by query discipline — Laravel's active DB connection is swapped per request to a wholly separate physical MySQL database, so there is no shared-table cross-tenant query path in application code to forget a WHERE clause on." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;fontColor=#1E293B;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;size=14;" vertex="1" parent="1"><mxGeometry x="1000" y="660" width="600" height="90" as="geometry"/></mxCell><mxCell id="c26" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#1E293B;fontSize=12;align=center;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="320" height="92" as="geometry"/></mxCell><mxCell id="c27" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#1E293B;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="320" height="22" as="geometry"/></mxCell><mxCell id="c28" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2563EB;strokeColor=#2563EB;fontColor=#1E293B;fontSize=12;align=center;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="48" y="806" width="14" height="14" as="geometry"/></mxCell><mxCell id="c29" value="Central / landlord (shared)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#1E293B;fontSize=10.5;align=left;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="68" y="803" width="284" height="20" as="geometry"/></mxCell><mxCell id="c30" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D97706;strokeColor=#D97706;fontColor=#1E293B;fontSize=12;align=center;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="48" y="828" width="14" height="14" as="geometry"/></mxCell><mxCell id="c31" value="Tenant-resolution middleware" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#1E293B;fontSize=10.5;align=left;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="68" y="825" width="284" height="20" as="geometry"/></mxCell><mxCell id="c32" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#059669;strokeColor=#059669;fontColor=#1E293B;fontSize=12;align=center;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="48" y="850" width="14" height="14" as="geometry"/></mxCell><mxCell id="c33" value="Tenant database (isolated)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#1E293B;fontSize=10.5;align=left;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="68" y="847" width="284" height="20" as="geometry"/></mxCell><mxCell id="c34" value="Evidence: config/tenancy.php; config/database.php:13-31; app/Models/Tenant.php; app/Http/Middleware/EnsureCentralDomain.php; routes/tenant.php:58-65; database/migrations/landlord/**; database/migrations/tenant/**; docs/TENANCY.md" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#1E293B;fontSize=9.5;align=left;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;fontStyle=2;spacingLeft=8;whiteSpace=wrap;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="1560" height="40" as="geometry"/></mxCell><mxCell id="c35" value="EAE — Thesis Architecture Package — Source: verified repository" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#475569;fontSize=9;align=left;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="1074" width="1150" height="18" as="geometry"/></mxCell><mxCell id="c36" value="04 Multi-Tenancy Isolation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#475569;fontSize=9;align=right;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="1200" y="1074" width="420" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="05 Auth Flow" id="05 Auth Flow"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Figure 5. Authentication and Authorization Flow" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#1E293B;fontSize=20;align=left;verticalAlign=middle;fontStyle=1;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1150" height="40" as="geometry"/></mxCell><mxCell id="c3" value="Tenant login and central-admin login sequences, with error branches." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#475569;fontSize=12;align=left;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1150" height="26" as="geometry"/></mxCell><mxCell id="c4" value="Verified" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#2563EB;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeomet