spacingTop=6;size=14;" vertex="1" parent="1"><mxGeometry x="150" y="440" width="560" height="90" as="geometry"/></mxCell><mxCell id="c23" value="Adaptive (CAT) sub-state: for is_adaptive_exam sessions, session_progress_json['cat']['status'] tracks in_progress/completed independently, per section. This is a private JSON sub-state machine, separate from the top-level session_state field shown here." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;fontColor=#1E293B;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;size=14;" vertex="1" parent="1"><mxGeometry x="820" y="440" width="560" height="90" as="geometry"/></mxCell><mxCell id="c24" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#1E293B;fontSize=12;align=center;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="340" height="92" as="geometry"/></mxCell><mxCell id="c25" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#1E293B;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="340" height="22" as="geometry"/></mxCell><mxCell id="c26" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D97706;strokeColor=#D97706;fontColor=#1E293B;fontSize=12;align=center;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="48" y="586" width="14" height="14" as="geometry"/></mxCell><mxCell id="c27" value="Non-terminal state" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#1E293B;fontSize=10.5;align=left;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="68" y="583" width="304" height="20" as="geometry"/></mxCell><mxCell id="c28" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#16A34A;strokeColor=#16A34A;fontColor=#1E293B;fontSize=12;align=center;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="48" y="608" width="14" height="14" as="geometry"/></mxCell><mxCell id="c29" value="Terminal state (isTerminal() = true)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#1E293B;fontSize=10.5;align=left;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="68" y="605" width="304" height="20" as="geometry"/></mxCell><mxCell id="c30" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DC2626;strokeColor=#DC2626;fontColor=#1E293B;fontSize=12;align=center;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="48" y="630" width="14" height="14" as="geometry"/></mxCell><mxCell id="c31" value="Terminate transition" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#1E293B;fontSize=10.5;align=left;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="68" y="627" width="304" height="20" as="geometry"/></mxCell><mxCell id="c32" value="Evidence: app/Domains/ExamSession/States/{ExamSessionState,PendingState,ActiveState,SuspendedState,CompletedState,TerminatedState,ExamSessionStateFactory}.php; app/Domains/ExamSession/Services/ExamSessionServiceImpl.php:76-530; app/Domains/ExamSession/Policies/ExamSessionPolicy.php; tests/Feature/ExamSession/ExamSessionLifecycleTest.php" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#1E293B;fontSize=9.5;align=left;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;fontStyle=2;spacingLeft=8;whiteSpace=wrap;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="400" y="560" width="1160" height="40" as="geometry"/></mxCell><mxCell id="c33" value="EAE — Thesis Architecture Package — Source: verified repository" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#475569;fontSize=9;align=left;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="1074" width="1150" height="18" as="geometry"/></mxCell><mxCell id="c34" value="25 Exam Session FSM" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#475569;fontSize=9;align=right;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="1200" y="1074" width="420" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="26 Workflow FSM" id="26 Workflow FSM"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Figure 26. Approval Workflow State Machine" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#1E293B;fontSize=20;align=left;verticalAlign=middle;fontStyle=1;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1150" height="40" as="geometry"/></mxCell><mxCell id="c3" value="UML state machine — 3 verified states on ApprovalWorkflow.current_workflow_status." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#475569;fontSize=12;align=left;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1150" height="26" as="geometry"/></mxCell><mxCell id="c4" value="Verified" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#2563EB;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="1200" y="16" width="420" height="30" as="geometry"/></mxCell><mxCell id="c5" value="Detail — state machine diagram" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#475569;fontSize=11;align=center;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="1200" y="50" width="420" height="22" as="geometry"/></mxCell><mxCell id="c6" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="120" y="260" width="22" height="22" as="geometry"/></mxCell><mxCell id="c7" value="pending&#10;(initiate())" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#1E293B;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="220" y="240" width="220" height="60" as="geometry"/></mxCell><mxCell id="c8" value="approved" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#1E293B;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="620" y="140" width="220" height="60" as="geometry"/></mxCell><mxCell id="c9" value="rejected" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#1E293B;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="620" y="360" width="220" height="60" as="geometry"/></mxCell><mxCell id="c10" value="initiate()&#10;workflows.manage&#10;[idempotent: existing pending&#10;workflow for same resource&#10;is returned, not duplicated]" style="html=1;endArrow=block;endFill=1;strokeColor=#2563EB;fontSize=8.5;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c11" value="approve()&#10;workflows.approve&#10;[requirePendingWorkflow() guard]" style="html=1;endArrow=block;endFill=1;strokeColor=#059669;fontSize=8.5;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="reject(reason)&#10;workflows.approve&#10;[reason required, 3-1000 chars,&#10;stored in workflow_metadata JSON]" style="html=1;endArrow=block;endFill=1;strokeColor=#DC2626;fontSize=8.5;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="Separation of Duties: enforced by permission split, NOT by an initiator-vs-approver id comparison. workflows.manage (initiate) and workflows.approve (approve/reject) are deliberately different permissions — a role that authors a workflow must not also hold the approving permission. No code compares initiated_by_user_id to the approver at approve/reject time." style="shape=note;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;fontColor=#1E293B;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;size=14;" vertex="1" parent="1"><mxGeometry x="120" y="440" width="500" height="100" as="geometry"/></mxCell><mxCell id="c14" value="Invalid transitions: approving/rejecting a non-pending workflow throws a plain RuntimeException, caught by the controller and returned as HTTP 422 invalid_workflow_state. Every transition writes a WorkflowHistory row (old_state → new_state) — an append-only audit ledger." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;fontColor=#1E293B;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;size=14;" vertex="1" parent="1"><mxGeometry x="660" y="440" width="500" height="100" as="geometry"/></mxCell><mxCell id="c15" value="workflows.approve is granted to NO seeded tenant role today (see page 24) — the approved/rejected states are reachable in code but not by any out-of-the-box role without a custom permission grant." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;fontColor=#1E293B;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;size=14;" vertex="1" parent="1"><mxGeometry x="1180" y="440" width="380" height="100" as="geometry"/></mxCell><mxCell id="c16" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#1E293B;fontSize=12;align=center;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="340" height="70" as="geometry"/></mxCell><mxCell id="c17" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#1E293B;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="340" height="22" as="geometry"/></mxCell><mxCell id="c18" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D97706;strokeColor=#D97706;fontColor=#1E293B;fontSize=12;align=center;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="48" y="596" width="14" height="14" as="geometry"/></mxCell><mxCell id="c19" value="Non-terminal state" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#1E293B;fontSize=10.5;align=left;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="68" y="593" width="304" height="20" as="geometry"/></mxCell><mxCell id="c20" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#16A34A;strokeColor=#16A34A;fontColor=#1E293B;fontSize=12;align=center;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="48" y="618" width="14" height="14" as="geometry"/></mxCell><mxCell id="c21" value="Terminal state" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#1E293B;fontSize=10.5;align=left;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="68" y="615" width="304" height="20" as="geometry"/></mxCell><mxCell id="c22" value="Evidence: app/Domains/Workflows/Models/ApprovalWorkflow.php:38; app/Domains/Workflows/Services/ApprovalWorkflowService.php:22-177; app/Domains/Workflows/Policies/ApprovalWorkflowPolicy.php:18-67; app/Http/Requests/Workflows/RejectWorkflowRequest.php:35-40; tests/Feature/Workflows/ApprovalWorkflowTest.php" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#1E293B;fontSize=9.5;align=left;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;fontStyle=2;spacingLeft=8;whiteSpace=wrap;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="400" y="570" width="1160" height="40" as="geometry"/></mxCell><mxCell id="c23" value="EAE — Thesis Architecture Package — Source: verified repository" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#475569;fontSize=9;align=left;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="1074" width="1150" height="18" as="geometry"/></mxCell><mxCell id="c24" value="26 Workflow FSM" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#475569;fontSize=9;align=right;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="1200" y="1074" width="420" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="27 Enrollment Lifecycle" id="27 Enrollment Lifecycle"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Figure 27. Enrollment Lifecycle — No Independent FSM Warranted" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#1E293B;fontSize=20;align=left;verticalAlign=middle;fontStyle=1;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1150" height="40" as="geometry"/></mxCell><mxCell id="c3" value="exam_enrollments.enrollment_status is a two-value flag, not a guarded state machine." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#475569;fontSize=12;align=left;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1150" height="26" as="geometry"/></mxCell><mxCell id="c4" value="Not Applicable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#64748B;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="1200" y="16" width="420" height="30" as="geometry"/></mxCell><mxCell id="c5" value="Detail — explanatory page, no fabricated FSM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#475569;fontSize=11;align=center;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="1200" y="50" width="420" height="22" as="geometry"/></mxCell><mxCell id="c6" value="Why no state-machine diagram is drawn here:&#10;&#10;The Enrollment/Eligibility spec asked for a state machine IF one exists. It does not. EnrollmentServiceImpl exposes exactly two operations — enroll() and revoke() — that write only two literal values to enrollment_status: 'active' and 'revoked'. The DB column default is 'pending', but no application code ever writes 'pending' — it can only appear via direct DB insertion bypassing the service. There is no 'completed', 'expired', or 'cancelled' status anywhere in the codebase." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;fontColor=#1E293B;fontSize=11;align=left;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;whiteSpace=wrap;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1560" height="120" as="geometry"/></mxCell><mxCell id="c7" value="Operation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="260" height="56" as="geometry"/></mxCell><mxCell id="c8" value="Behavior" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="300" y="240" width="780" height="56" as="geometry"/></mxCell><mxCell id="c9" value="Guard" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="1080" y="240" width="480" height="56" as="geometry"/></mxCell><mxCell id="c10" value="enroll()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#1E293B;fontSize=9.5;align=left;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;whiteSpace=wrap;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="296" width="260" height="56" as="geometry"/></mxCell><mxCell id="c11" value="Creates 'active', or if a 'revoked' row exists for the same (tenant, candidate, exam), unconditionally flips it back to 'active' and resets attempts/dates." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#1E293B;fontSize=9.5;align=center;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;whiteSpace=wrap;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="300" y="296" width="780" height="56" as="geometry"/></mxCell><mxCell id="c12" value="Duplicate-prevention only: throws EnrollmentAlreadyExistsException if an 'active' row already exists. Not a transition guard between 3+ states." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#1E293B;fontSize=9.5;align=center;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;whiteSpace=wrap;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1080" y="296" width="480" height="56" as="geometry"/></mxCell><mxCell id="c13" value="revoke()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#1E293B;fontSize=9.5;align=left;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;whiteSpace=wrap;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="352" width="260" height="56" as="geometry"/></mxCell><mxCell id="c14" value="Unconditionally sets 'revoked', regardless of current status." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#1E293B;fontSize=9.5;align=center;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;whiteSpace=wrap;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="300" y="352" width="780" height="56" as="geometry"/></mxCell><mxCell id="c15" value="None — no check that it isn't already revoked, no check for an in-progress session." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#1E293B;fontSize=9.5;align=center;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;whiteSpace=wrap;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1080" y="352" width="480" height="56" as="geometry"/></mxCell><mxCell id="c16" value="Verified functional gap (not a state-machine claim): attempts_used is initialized to 0 by enroll(), but no code path anywhere in the repository increments it when a session starts or completes. The 'attempts exhausted' eligibility gate reads a counter that is never advanced — flagged on the Risks page (37), not fabricated as a lifecycle state." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;fontColor=#1E293B;fontSize=10;align=left;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;whiteSpace=wrap;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="428" width="1560" height="70" as="geometry"/></mxCell><mxCell id="c17" value="Contrast: Workflows.approval_workflows DOES implement a genuine guarded multi-state machine with an audit ledger (workflow_history.old_state/new_state) — see page 26. Enrollment does not meet that bar." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#1E293B;fontSize=10;align=left;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;whiteSpace=wrap;spacingLeft=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="518" width="1560" height="60" as="geometry"/></mxCell><mxCell id="c18" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#1E293B;fontSize=12;align=center;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="598" width="320" height="48" as="geometry"/></mxCell><mxCell id="c19" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#1E293B;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="598" width="320" height="22" as="geometry"/></mxCell><mxCell id="c20" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DC2626;strokeColor=#DC2626;fontColor=#1E293B;fontSize=12;align=center;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="48" y="624" width="14" height="14" as="geometry"/></mxCell><mxCell id="c21" value="CRUD-with-status-field, not an FSM" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#1E293B;fontSize=10.5;align=left;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="68" y="621" width="284" height="20" as="geometry"/></mxCell><mxCell id="c22" value="Evidence: app/Domains/ExamSession/Services/EnrollmentServiceImpl.php:23-96; app/Domains/ExamSession/Models/ExamCandidateEligible.php; database/migrations/tenant/02_assessment_and_exams/2026_05_16_000250_create_exam_enrollments_table.php" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#1E293B;fontSize=9.5;align=left;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;fontStyle=2;spacingLeft=8;whiteSpace=wrap;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="400" y="598" width="120