 x="60" y="382" width="720" height="74" as="geometry"/></mxCell><mxCell id="c12" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#334155;" edge="1" parent="1" source="c9" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="Eloquent Model / Database&#10;App\Domains\&lt;Domain&gt;\Models\&lt;X&gt; → tenant MySQL table" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#1E293B;fontSize=10.5;align=center;verticalAlign=middle;fontStyle=1;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="476" width="720" height="74" as="geometry"/></mxCell><mxCell id="c14" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#334155;" edge="1" parent="1" source="c11" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="Example verified chain (ExamSession):&#10;ExamSessionController::submitResponse()&#10;→ ExamSessionServiceImpl::submitResponse()&#10;→ SessionRepository::findByIdForUpdate()&#10;→ CandidateExamStatus (table exam_sessions)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#1E293B;fontSize=9.5;align=left;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;whiteSpace=wrap;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="566" width="720" height="70" as="geometry"/></mxCell><mxCell id="c16" value="Cross-cutting concerns (span every layer)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="840" y="100" width="740" height="30" as="geometry"/></mxCell><mxCell id="c17" value="Middleware&#10;auth:sanctum, InitializeTenancyBySubdomain, ThrottleLoginMiddleware, EnsureIdempotency, SecurityHeaders — wrap the Controller layer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#1E293B;fontSize=9.5;align=left;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;whiteSpace=wrap;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="840" y="140" width="740" height="60" as="geometry"/></mxCell><mxCell id="c18" value="Authorization&#10;$this-&gt;authorize() → Policy classes (17 total) — sits between Controller and Service; auto-wired per domain ServiceProvider" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#1E293B;fontSize=9.5;align=left;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;whiteSpace=wrap;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="840" y="210" width="740" height="60" as="geometry"/></mxCell><mxCell id="c19" value="Dependency Injection&#10;DomainServiceProvider auto-discovers every app/Domains/*/Providers/*.php (except Shared) and binds Contract → Impl, e.g. bind(ExamSessionService::class, ExamSessionServiceImpl::class)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#1E293B;fontSize=9.5;align=left;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;whiteSpace=wrap;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="840" y="280" width="740" height="60" as="geometry"/></mxCell><mxCell id="c20" value="Domain Events / Queue&#10;ResponseSubmitted, ExamSessionCompleted (ExamSession) → queued Listeners in Grading, QuestionBank, Analytics; ProctorEventLogged (Proctoring) → Penalties" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#1E293B;fontSize=9.5;align=left;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;whiteSpace=wrap;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="840" y="350" width="740" height="60" as="geometry"/></mxCell><mxCell id="c21" value="Tenancy&#10;DatabaseTenancyBootstrapper swaps the Eloquent connection ambiently — no per-model $connection override needed" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#1E293B;fontSize=9.5;align=left;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;whiteSpace=wrap;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="840" y="420" width="740" height="60" as="geometry"/></mxCell><mxCell id="c22" value="Verified deviations from the strict layering" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DC2626;strokeColor=#DC2626;fontColor=#FFFFFF;fontSize=10.5;align=center;verticalAlign=middle;fontStyle=1;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="840" y="500" width="740" height="26" as="geometry"/></mxCell><mxCell id="c23" value="(a) 6 controllers query Eloquent models directly, skipping Service + Repository (e.g. ExamSectionController, CertificateController, QuestionVersionController)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;fontColor=#1E293B;fontSize=9;align=left;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;whiteSpace=wrap;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="840" y="530" width="740" height="40" as="geometry"/></mxCell><mxCell id="c24" value="(b) 7 controllers inject a Repository directly alongside the Service (e.g. AuthController, UserController, RoleController, QuestionController)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;fontColor=#1E293B;fontSize=9;align=left;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;whiteSpace=wrap;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="840" y="576" width="740" height="40" as="geometry"/></mxCell><mxCell id="c25" value="(c) Central and Analytics domains have no Repository layer at all — their Services query Eloquent models directly." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;fontColor=#1E293B;fontSize=9;align=left;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;whiteSpace=wrap;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="840" y="622" width="740" height="40" as="geometry"/></mxCell><mxCell id="c26" value="(d) Workflows has no Contract interface — ApprovalWorkflowService is a concrete class, self-bound in its provider." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;fontColor=#1E293B;fontSize=9;align=left;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;whiteSpace=wrap;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="840" y="668" width="740" height="40" as="geometry"/></mxCell><mxCell id="c27" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#1E293B;fontSize=12;align=center;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="960" width="340" height="114" as="geometry"/></mxCell><mxCell id="c28" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#1E293B;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="960" width="340" height="22" as="geometry"/></mxCell><mxCell id="c29" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2563EB;strokeColor=#2563EB;fontColor=#1E293B;fontSize=12;align=center;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="68" y="986" width="14" height="14" as="geometry"/></mxCell><mxCell id="c30" value="Framework-facing / interface layer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#1E293B;fontSize=10.5;align=left;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="88" y="983" width="304" height="20" as="geometry"/></mxCell><mxCell id="c31" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#059669;strokeColor=#059669;fontColor=#1E293B;fontSize=12;align=center;verticalAlign=middle;fontStyle=0;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="68" y="1008" width="14" height="14" as="geometry"/></mxCell><mxCell id="c32" value="Domain service implementation" style