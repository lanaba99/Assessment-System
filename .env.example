APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Used only for local API-documentation generation (Scribe response calls).
# Run `php artisan db:seed --class=Database\Seeders\DocsSandboxTenantSeeder`
# once, then leave these as-is (or override) before `php artisan scribe:generate`.
SCRIBE_TENANT_ID=00000000-0000-4000-8000-000000000001
SCRIBE_TENANT_SUBDOMAIN=docs-sandbox

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production once HTTPS is terminated correctly (see
# docs/SECURITY_BASELINE.md) — left false here so cookies still work over
# plain-HTTP local/Sail development.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# redis, not database: this app's tenancy cache bootstrapper wraps every
# Cache:: call in cache tags while a tenant is active, and Laravel's
# "database" cache store does not support tagging (confirmed — it throws
# BadMethodCallException the first time any tenant-context code calls
# Cache::, e.g. the Idempotency-Key middleware). Never use CACHE_STORE=array
# in production either — it's non-persistent and per-process, fine for
# tests/CI (see phpunit.xml) but wrong for a real multi-process deployment.
CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
# "redis" is the Sail/Docker service hostname (see compose.yaml) — override
# to 127.0.0.1 for a bare-metal/non-Docker setup or when running against a
# Redis reachable only via localhost (e.g. some CI runners).
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Comma-separated list of frontend origins allowed to call this API from a
# browser (Web team's SPA). Empty by default — no origin is allowed until
# this is set explicitly; never use "*" here, this API accepts bearer
# tokens. Example: CORS_ALLOWED_ORIGINS=https://app.example.com,https://staging.example.com
CORS_ALLOWED_ORIGINS=

# Comma-separated IPs/CIDRs of reverse proxies/load balancers this app should
# trust for X-Forwarded-* headers. Empty by default (trusts nothing, exactly
# today's behavior) — a production deployment behind a real proxy MUST set
# this to that proxy's real address(es), never guessed here. See
# docs/SECURITY_BASELINE.md.
TRUSTED_PROXIES=

# "log" writes mail content — including password-reset tokens — straight to
# storage/logs/laravel.log. Fine for local/CI (APP_ENV=local/testing), but
# app/Providers/AppServiceProvider.php refuses to boot with this mailer in
# any other environment. Set a real transport (smtp/ses/postmark/resend)
# before deploying anywhere else.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Only needed to run `scribe:generate` against routes that require a
# pre-shared key rather than a Sanctum token. Leave blank unless such a
# route exists.
# SCRIBE_AUTH_KEY=

VITE_APP_NAME="${APP_NAME}"
